# Carbon Proxy Configuration
# Copy to .env and fill in values

# --- Required ---
UPSTREAM_URL=http://localhost:8080
# LISTEN_PORT=8080
# SQLITE_PATH=/data/carbon.db

# --- API Key Mapping (comma-separated key:name pairs) ---
# Maps bearer tokens to source names for tracking
# API_KEYS=sk-webui:openwebui,sk-claude:claude-code

# --- Carbon Intensity ---
# Static fallback (gCO2/kWh). Default: 400
# CARBON_INTENSITY=400

# Real-time carbon intensity (overrides static value if set)
# ELECTRICITYMAP_API_KEY=
# ELECTRICITYMAP_ZONE=US-CAL-CISO

# --- Power Measurement ---
# POWER_SAMPLE_HZ=10
# Manual TDP override (watts). Auto-detected if not set.
# TDP_CPU_WATTS=0
# TDP_GPU_WATTS=0

# --- Offset Purchasing ---
# Provider: "cnaught", "tree-nation", or "both"
# OFFSET_PROVIDER=cnaught

# Required bearer token for POST /carbon/offset (disabled if empty)
# OFFSET_API_KEY=

# CNaught API (https://cnaught.com)
# CNAUGHT_API_KEY=
# CNAUGHT_PORTFOLIO_ID=          # Optional, uses default portfolio if empty

# Tree-Nation API (https://tree-nation.com)
# TREE_NATION_API_KEY=
# TREE_NATION_PLANTER_ID=0
# TREE_NATION_SPECIES_ID=0

# --- Cloudflare Workers KV (edge API-key validation) ---
# When all three are set, the dashboard can issue API keys that the worker
# validates from KV without round-tripping to origin. Reuses OFFSET_API_KEY
# for management endpoint auth.
# CLOUDFLARE_API_TOKEN=         # scoped to "Workers KV Storage: Edit" on one namespace
# CLOUDFLARE_ACCOUNT_ID=
# KV_NAMESPACE_ID=
# How often the reconciler heals drift between local DB and KV (seconds)
# KV_RECONCILER_INTERVAL_S=300

# Shared secret with the Cloudflare worker. When set, the proxy catch-all
# (/v1/* and anything else not explicitly handled) rejects requests that
# don't carry a matching X-Worker-Origin-Secret header. This is what stops
# someone from curling the tunnel hostname directly to bypass the worker's
# bearer check. Generate with `openssl rand -hex 32`, then set the same
# value as a wrangler secret on the worker: `wrangler secret put ORIGIN_SECRET`.
# Leave empty in local dev if you don't want the check.
# WORKER_ORIGIN_SECRET=

# Public-facing URL clients should use to call this API. Embedded into the
# code snippets the dashboard shows after creating an API key. If empty, the
# dashboard falls back to its own origin.
# PUBLIC_API_URL=https://api.devita.dev

# --- TRMNL e-ink Display ---
# Push carbon summary to TRMNL device via webhook
# TRMNL_ENABLED=false
# TRMNL_PLUGIN_UUID=
# TRMNL_PUSH_INTERVAL=300
